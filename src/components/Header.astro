---
---

<header
	class="fixed top-0 left-0 right-0 z-50 bg-[#0b0f17]/80 backdrop-blur-sm border-b border-[#334155]/50 transition-all duration-300"
	id="header"
>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex items-center justify-between h-16">
			<div class="flex-shrink-0 flex items-center space-x-2">
					<img src="/logo.svg" alt="MetricTether" class="w-8 h-8" />
					<span class="text-xl font-heading font-bold text-[#f1f5f9]">MetricTether</span>
				</div>

			<nav class="hidden md:flex space-x-8">
				<a
					href="#products"
					class="text-[#94a3b8] hover:text-[#38bdf8] transition-colors duration-200 font-medium"
				>Products</a>
				<a
					href="#how-it-works"
					class="text-[#94a3b8] hover:text-[#38bdf8] transition-colors duration-200 font-medium"
				>How It Works</a>
			</nav>

			<div class="hidden md:block">
				<a
					href="#waitlist"
					class="bg-gradient-to-r from-[#6366f1] to-[#38bdf8] text-[#0b0f17] font-heading font-semibold py-2 px-5 rounded-lg transition-all duration-300 ease-out hover:scale-[1.02] hover:shadow-[0_0_25px_rgba(99,102,241,0.4)]"
				>
					Request Early Access
				</a>
			</div>

			<div class="md:hidden">
				<button
					id="mobile-menu-button"
					class="text-[#94a3b8] hover:text-[#f1f5f9] focus:outline-none"
					aria-label="Toggle navigation menu"
				>
					<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>

	<div
		id="mobile-menu"
		class="md:hidden hidden border-t border-[#334155]/30 bg-[#121826]"
	>
		<div class="px-2 pt-2 pb-3 space-y-1">
			<a
				href="#products"
				class="block px-3 py-2 text-[#94a3b8] hover:text-[#38bdf8] transition-colors duration-200 font-medium"
				>Products</a
			>
			<a
				href="#how-it-works"
				class="block px-3 py-2 text-[#94a3b8] hover:text-[#38bdf8] transition-colors duration-200 font-medium"
				>How It Works</a
			>
			<a
				href="#waitlist"
				class="block mx-3 mt-2 text-center bg-gradient-to-r from-[#6366f1] to-[#38bdf8] text-[#0b0f17] font-heading font-semibold py-2 px-4 rounded-lg transition-all duration-300 ease-out hover:scale-[1.02]"
				>
				Request Early Access
			</a>
		</div>
	</div>
</header>

<script>
	const menuButton = document.getElementById('mobile-menu-button');
	const menu = document.getElementById('mobile-menu');

	if (menuButton && menu) {
		menuButton.addEventListener('click', () => {
			menu.classList.toggle('hidden');
		});
	}

	const header = document.getElementById('header');
	window.addEventListener('scroll', () => {
		if (window.scrollY > 20) {
			header?.classList.add('shadow-[0_2px_20px_rgba(0,0,0,0.3)]');
		} else {
			header?.classList.remove('shadow-[0_2px_20px_rgba(0,0,0,0.3)]');
		}
	});
</script>
