---
---

<section class="relative isolate flex min-h-[100svh] items-center overflow-hidden pt-16">
	<div class="absolute inset-0 -z-10 bg-[#0b0f17]"></div>
	<div class="absolute -left-32 top-1/4 -z-10 h-96 w-96 rounded-full bg-[#6366f1]/10 blur-3xl animate-pulse-slow"></div>
	<div class="absolute -right-32 bottom-1/4 -z-10 h-96 w-96 rounded-full bg-[#38bdf8]/10 blur-3xl animate-pulse-slow"></div>

	<div class="mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
		<div class="flex flex-col items-center text-center">
			<span class="inline-flex items-center gap-2 rounded-full border border-[#334155]/60 bg-[#121826]/60 px-3 py-1 text-xs font-medium text-[#38bdf8]">
				<span class="h-1.5 w-1.5 rounded-full bg-[#10b981]"></span>
				AI Software Agents
			</span>

			<h1 class="mt-6 font-heading text-4xl font-extrabold leading-tight text-[#f1f5f9] sm:text-5xl lg:text-6xl">
				Autonomous AI Agents That
				<span class="block bg-gradient-to-r from-[#6366f1] to-[#38bdf8] bg-clip-text text-transparent">
					Guard Your Revenue
				</span>
				<span class="block bg-gradient-to-r from-[#10b981] to-[#38bdf8] bg-clip-text text-transparent">
					& Stabilize Your Cash Flow
				</span>
			</h1>

			<p class="mt-6 max-w-3xl text-lg text-[#94a3b8] sm:text-xl">
				MetricTether builds intelligent, agentic software tools that transform raw business
				telemetry into proactive automated workflows — from AI-driven churn interviews to
				dynamic cash flow forecasting.
			</p>

			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<span class="inline-flex items-center gap-1.5 rounded-full border border-[#334155]/60 bg-[#121826]/60 px-3 py-1 text-xs font-medium text-[#94a3b8]">
					⚡ Powered by Agentic Workflows
				</span>
				<span class="inline-flex items-center gap-1.5 rounded-full border border-[#334155]/60 bg-[#121826]/60 px-3 py-1 text-xs font-medium text-[#94a3b8]">
					🔒 Privacy First
				</span>
				<span class="inline-flex items-center gap-1.5 rounded-full border border-[#334155]/60 bg-[#121826]/60 px-3 py-1 text-xs font-medium text-[#94a3b8]">
					📊 Real-Time Telemetry
				</span>
			</div>

			<div class="mt-10 flex w-full max-w-lg flex-col gap-4 sm:flex-row sm:justify-center">
				<a
					href="#products"
					class="inline-flex items-center justify-center rounded-lg bg-gradient-to-r from-[#6366f1] to-[#38bdf8] px-8 py-3 font-heading text-base font-semibold text-[#0b0f17] transition-transform duration-200 hover:scale-[1.02]"
				>
					View Products
					<svg class="ml-2 h-4 w-4" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
				<a
					href="#waitlist"
					class="inline-flex items-center justify-center rounded-lg border border-[#334155] px-8 py-3 font-heading text-base font-semibold text-[#f1f5f9] transition-colors duration-200 hover:bg-[#1e293b]"
				>
					Request Early Access
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	@keyframes pulse-slow {
		0%, 100% { opacity: 0.8; }
		50% { opacity: 0.4; }
	}
	.animate-pulse-slow {
		animation: pulse-slow 4s ease-in-out infinite;
	}
</style>
