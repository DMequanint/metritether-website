---
---

<section class="relative isolate flex min-h-screen items-center pt-16 overflow-hidden">
	<div class="absolute inset-0 bg-[#0b0f17] -z-10"></div>

	<div class="absolute top-1/3 -left-1/2 w-1/2 h-1/2 bg-[#6366f1]/8 rounded-full blur-3xl -z-10 animate-pulse-slow"></div>
	<div class="absolute bottom-1/3 -right-1/2 w-1/2 h-1/2 bg-[#38bdf8]/8 rounded-full blur-3xl -z-10 animate-pulse-slow"></div>

	<div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
		<div class="flex flex-col items-center text-center">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium text-[#38bdf8] bg-[#121826]/50 border border-[#334155]/50 mb-6">
				<span class="w-1.5 h-1.5 bg-[#10b981] rounded-full"></span>
				Agentic Automation Platform
			</div>

			<h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold text-[#f1f5f9] mb-6 leading-tight">
				Autonomous AI Agents That
				<span class="block text-transparent bg-clip-text bg-gradient-to-r from-[#6366f1] to-[#38bdf8]">
					Guard Your Revenue
				</span>
				<span class="block text-transparent bg-clip-text bg-gradient-to-r from-[#10b981] to-[#38bdf8]">
					& Stabilize Your Cash Flow.
				</span>
			</h1>

			<p class="text-lg sm:text-xl text-[#94a3b8] max-w-3xl mb-8">
				MetricTether builds intelligent, agentic software tools that transform raw business telemetry into
				proactive automated workflows&mdash;from AI-driven churn interviews to dynamic cashflow forecasting.
			</p>

			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-8 w-full max-w-lg">
				<a
					href="#products"
					class="flex-1 sm:flex-none inline-flex items-center justify-center bg-gradient-to-r from-[#6366f1] to-[#38bdf8] text-[#0b0f17] font-heading font-semibold py-3 px-8 rounded-lg transition-all duration-300 ease-out hover:scale-[1.02] hover:shadow-[0_0_25px_rgba(99,102,241,0.4)]"
				>
					Explore Our Products
					<svg class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</a>
				<a
					href="#waitlist"
					class="flex-1 sm:flex-none inline-flex items-center justify-center border border-[#334155] text-[#f1f5f9] font-heading font-semibold py-3 px-8 rounded-lg transition-all duration-300 ease-out hover:bg-[#1e293b] hover:border-[#6366f1]/30"
				>
					Join the Waitlist
				</a>
			</div>

			<div class="flex flex-wrap justify-center gap-3 text-xs text-[#64748b]">
				<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#121826]/50 border border-[#334155]/50">
					Powered by Agentic Workflows
				</span>
				<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#121826]/50 border border-[#334155]/50">
					Privacy First
				</span>
				<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#121826]/50 border border-[#334155]/50">
					Real-Time Telemetry
				</span>
			</div>
		</div>
	</div>
</section>

<style>
	@keyframes pulse-slow {
		0%, 100% { opacity: 0.7; }
		50% { opacity: 0.4; }
	}
	.animate-pulse-slow {
		animation: pulse-slow 4s ease-in-out infinite;
	}
</style>
