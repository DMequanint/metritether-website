---
---

<section id="how-it-works" class="py-20 relative">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="text-center mb-16">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium text-[#38bdf8] bg-[#121826]/50 border border-[#334155]/50 mb-4">
				Workflow
			</div>
			<h2 class="text-3xl sm:text-4xl font-heading font-bold text-[#f1f5f9] mb-4">
				How MetricTether Works
			</h2>
			<p class="text-[#94a3b8] max-w-2xl mx-auto">
				How our AI agents observe, reason, and take action.
			</p>
		</div>

		<div class="relative">
			<div class="hidden lg:block absolute top-1/2 left-0 right-0 h-0.5 bg-gradient-to-r from-[#6366f1] via-[#38bdf8] to-[#10b981] opacity-20 z-0"></div>

			<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-0 relative z-10">
				<div class="text-center lg:text-left">
					<div class="w-16 h-16 mx-auto lg:mx-0 mb-6 rounded-xl bg-gradient-to-br from-[#6366f1]/20 to-[#38bdf8]/20 flex items-center justify-center border border-[#334155]/50">
						<div class="w-8 h-8 bg-[#38bdf8] rounded-full flex items-center justify-center">
							<span class="text-[#0b0f17] font-heading font-bold text-sm">1</span>
						</div>
					</div>
					<h3 class="text-xl font-heading font-bold text-[#f1f5f9] mb-3">Passive Observation</h3>
					<p class="text-[#94a3b8] text-sm leading-relaxed">
						Connects to your existing stack to capture raw events—cancellations, bank feeds,
						payment delays, usage patterns. All data ingested in real time.
					</p>
				</div>

				<div class="text-center lg:text-left lg:px-12 lg:py-0 py-12 border-t lg:border-t-0 border-[#334155]/30">
					<div class="w-16 h-16 mx-auto lg:mx-0 mb-6 rounded-xl bg-gradient-to-br from-[#38bdf8]/20 to-[#10b981]/20 flex items-center justify-center border border-[#334155]/50">
						<div class="w-8 h-8 bg-[#10b981] rounded-full flex items-center justify-center">
							<span class="text-[#0b0f17] font-heading font-bold text-sm">2</span>
						</div>
					</div>
					<h3 class="text-xl font-heading font-bold text-[#f1f5f9] mb-3">Autonomous Reasoning</h3>
					<p class="text-[#94a3b8] text-sm leading-relaxed">
						The AI agent evaluates context, formulates an action strategy, and executes personalized
						outreach—all without human intervention.
					</p>
				</div>

				<div class="text-center lg:text-left">
					<div class="w-16 h-16 mx-auto lg:mx-0 mb-6 rounded-xl bg-gradient-to-br from-[#10b981]/20 to-[#f43f5e]/20 flex items-center justify-center border border-[#334155]/50">
						<div class="w-8 h-8 bg-[#f43f5e] rounded-full flex items-center justify-center">
							<span class="text-[#0b0f17] font-heading font-bold text-sm">3</span>
						</div>
					</div>
					<h3 class="text-xl font-heading font-bold text-[#f1f5f9] mb-3">Tethered Action</h3>
					<p class="text-[#94a3b8] text-sm leading-relaxed">
						Insights are logged, revenue recovered, cash flows rebalanced. Results feed back
						into the telemetry layer, closing the autonomous loop.
					</p>
				</div>
			</div>
		</div>

		<div class="mt-20 bg-[#121826]/50 border border-[#334155]/50 rounded-xl p-6 sm:p-8">
			<div class="mb-4">
				<h3 class="text-xl font-heading font-bold text-[#f1f5f9]">How an Agent Handles an Event</h3>
			</div>

			<div class="h-48 sm:h-64 relative">
				<svg class="w-full h-full" viewBox="0 0 800 200" preserveAspectRatio="xMidYMid meet">
					<defs>
						<linearGradient id="grad-flow" x1="0%" y1="0%" x2="100%" y2="0%">
							<stop offset="0%" stop-color="#6366f1" />
							<stop offset="50%" stop-color="#38bdf8" />
							<stop offset="100%" stop-color="#10b981" />
						</linearGradient>
					</defs>

					<circle cx="100" cy="100" r="30" fill="rgba(99, 102, 241, 0.1)" stroke="url(#grad-flow)" stroke-width="2" />
					<text x="100" y="105" text-anchor="middle" class="fill-[#94a3b8] text-sm font-mono">Ingestion</text>

					<path d="M130 100 C200 100 200 60 270 60" stroke="url(#grad-flow)" stroke-width="2" fill="none" stroke-dasharray="4 3" />

					<circle cx="300" cy="60" r="30" fill="rgba(56, 189, 248, 0.1)" stroke="url(#grad-flow)" stroke-width="2" />
					<text x="300" y="65" text-anchor="middle" class="fill-[#94a3b8] text-sm font-mono">Reasoning</text>

					<path d="M330 60 C400 60 400 140 470 140" stroke="url(#grad-flow)" stroke-width="2" fill="none" stroke-dasharray="4 3" />

					<circle cx="500" cy="140" r="30" fill="rgba(16, 185, 129, 0.1)" stroke="url(#grad-flow)" stroke-width="2" />
					<text x="500" y="145" text-anchor="middle" class="fill-[#94a3b8] text-sm font-mono">Action</text>

					<path d="M530 140 C580 140 580 100 650 100" stroke="url(#grad-flow)" stroke-width="2" fill="none" stroke-dasharray="4 3" />

					<circle cx="700" cy="100" r="30" fill="rgba(244, 63, 94, 0.1)" stroke="url(#grad-flow)" stroke-width="2" />
					<text x="700" y="105" text-anchor="middle" class="fill-[#94a3b8] text-sm font-mono">Telemetry</text>

					<path d="M730 100 C760 100 770 100 800 100" stroke="url(#grad-flow)" stroke-width="2" fill="none" stroke-dasharray="4 3" />
				</svg>
			</div>
		</div>
	</div>
</section>
