---
---

<section id="how-it-works" class="relative py-20 sm:py-28">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto mb-16 max-w-2xl text-center">
			<span class="inline-flex items-center gap-2 rounded-full border border-[#334155]/60 bg-[#121826]/60 px-3 py-1 text-xs font-medium text-[#38bdf8]">
				Workflow
			</span>
			<h2 class="mt-4 font-heading text-3xl font-bold text-[#f1f5f9] sm:text-4xl">
				How MetricTether Works
			</h2>
			<p class="mt-4 text-[#94a3b8]">
				How our AI agents observe, reason, and take action.
			</p>
		</div>

		<div class="grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-8">
			<div class="relative">
				<div
					class="mb-6 flex h-16 w-16 items-center justify-center rounded-xl border border-[#334155]/50 bg-gradient-to-br from-[#6366f1]/20 to-[#38bdf8]/20"
				>
					<div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#38bdf8]">
						<span class="font-heading text-sm font-bold text-[#0b0f17]">1</span>
					</div>
				</div>
				<h3 class="font-heading text-xl font-bold text-[#f1f5f9]">Passive Observation</h3>
				<p class="mt-3 text-sm leading-relaxed text-[#94a3b8]">
					Connects to your existing stack and captures events — cancellations, bank feeds,
					payment delays, usage patterns — in real time.
				</p>
			</div>

			<div class="relative">
				<div
					class="mb-6 flex h-16 w-16 items-center justify-center rounded-xl border border-[#334155]/50 bg-gradient-to-br from-[#38bdf8]/20 to-[#10b981]/20"
				>
					<div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#10b981]">
						<span class="font-heading text-sm font-bold text-[#0b0f17]">2</span>
					</div>
				</div>
				<h3 class="font-heading text-xl font-bold text-[#f1f5f9]">Autonomous Reasoning</h3>
				<p class="mt-3 text-sm leading-relaxed text-[#94a3b8]">
					The agent evaluates the context, decides on an action strategy, and executes
					personalised outreach without human intervention.
				</p>
			</div>

			<div class="relative">
				<div
					class="mb-6 flex h-16 w-16 items-center justify-center rounded-xl border border-[#334155]/50 bg-gradient-to-br from-[#10b981]/20 to-[#f43f5e]/20"
				>
					<div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#f43f5e]">
						<span class="font-heading text-sm font-bold text-[#0b0f17]">3</span>
					</div>
				</div>
				<h3 class="font-heading text-xl font-bold text-[#f1f5f9]">Tethered Action</h3>
				<p class="mt-3 text-sm leading-relaxed text-[#94a3b8]">
					Results are logged and fed back into the telemetry layer, closing the loop —
					revenue recovered, cash flows rebalanced.
				</p>
			</div>
		</div>

		<div class="mt-16 rounded-2xl border border-[#334155]/50 bg-[#121826]/60 p-6 sm:p-8">
			<h3 class="mb-6 font-heading text-xl font-bold text-[#f1f5f9]">End-to-End Flow</h3>
			<div class="h-48 sm:h-64">
				<svg class="h-full w-full" viewBox="0 0 800 200" preserveAspectRatio="xMidYMid meet">
					<defs>
						<linearGradient id="grad-flow" x1="0%" y1="0%" x2="100%" y2="0%">
							<stop offset="0%" stop-color="#6366f1" />
							<stop offset="50%" stop-color="#38bdf8" />
							<stop offset="100%" stop-color="#10b981" />
						</linearGradient>
					</defs>

					<circle cx="100" cy="100" r="30" fill="rgba(99, 102, 241, 0.1)" stroke="url(#grad-flow)" stroke-width="2" />
					<text x="100" y="105" text-anchor="middle" class="fill-[#94a3b8] text-sm font-mono">Ingestion</text>

					<path d="M130 100 C200 100 200 60 270 60" stroke="url(#grad-flow)" stroke-width="2" fill="none" stroke-dasharray="4 3" />

					<circle cx="300" cy="60" r="30" fill="rgba(56, 189, 248, 0.1)" stroke="url(#grad-flow)" stroke-width="2" />
					<text x="300" y="65" text-anchor="middle" class="fill-[#94a3b8] text-sm font-mono">Reasoning</text>

					<path d="M330 60 C400 60 400 140 470 140" stroke="url(#grad-flow)" stroke-width="2" fill="none" stroke-dasharray="4 3" />

					<circle cx="500" cy="140" r="30" fill="rgba(16, 185, 129, 0.1)" stroke="url(#grad-flow)" stroke-width="2" />
					<text x="500" y="145" text-anchor="middle" class="fill-[#94a3b8] text-sm font-mono">Action</text>

					<path d="M530 140 C580 140 580 100 650 100" stroke="url(#grad-flow)" stroke-width="2" fill="none" stroke-dasharray="4 3" />

					<circle cx="700" cy="100" r="30" fill="rgba(244, 63, 94, 0.1)" stroke="url(#grad-flow)" stroke-width="2" />
					<text x="700" y="105" text-anchor="middle" class="fill-[#94a3b8] text-sm font-mono">Telemetry</text>

					<path d="M730 100 C760 100 770 100 800 100" stroke="url(#grad-flow)" stroke-width="2" fill="none" stroke-dasharray="4 3" />
				</svg>
			</div>
		</div>
	</div>
</section>
