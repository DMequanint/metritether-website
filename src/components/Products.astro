---
interface Product {
	id: string;
	title: string;
	tagline: string;
	description: string;
	features: string[];
	accentColor: string;
	icon: 'churn' | 'cashflow' | 'sandbox';
}

const products: Product[] = [
	{
		id: 'churn',
		title: 'Churn Analytics',
		tagline: 'AI exit interviews for SaaS subscriptions',
		description:
			'An AI agent interviews customers by email when they cancel, asks questions based on their usage history, and structures the answers into churn analytics.',
		features: [
			'Structured churn analytics from natural email conversations.',
			'Win-back offers — discounts or pauses — negotiated in-thread.',
			'Root causes categorised with confidence scores.',
		],
		accentColor: '#38bdf8',
		icon: 'churn',
	},
	{
		id: 'cashflow',
		title: 'FreelancerCashFlow',
		tagline: 'Financial OS for freelancers and agencies',
		description:
			'Syncs invoices and bank feeds, forecasts cash flow, and auto-chases late payments — so income stops being a surprise.',
		features: [
			'Cash flow forecasting with 30/60/90-day runway.',
			'Income Volatility Index scores each client\u2019s payment risk.',
			'5-stage invoice chasing with late-fee calculation.',
		],
		accentColor: '#10b981',
		icon: 'cashflow',
	},
	{
		id: 'sandbox',
		title: 'Custom AI Agents Sandbox',
		tagline: 'Built-to-order agents for your operations',
		description:
			'LLM-backed agents designed for a specific operational bottleneck — invoice auditing, lead scoring, vendor management, or anything in between.',
		features: [
			'Built to order for a specific workflow.',
			'Plug-and-play integrations with fast deployment.',
			'Fully auditable decision logs.',
		],
		accentColor: '#6366f1',
		icon: 'sandbox',
	},
];
---

<section id="products" class="relative py-20 sm:py-28">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto mb-16 max-w-2xl text-center">
			<span class="inline-flex items-center gap-2 rounded-full border border-[#334155]/60 bg-[#121826]/60 px-3 py-1 text-xs font-medium text-[#38bdf8]">
				Products
			</span>
			<h2 class="mt-4 font-heading text-3xl font-bold text-[#f1f5f9] sm:text-4xl">
				Our Products
			</h2>
			<p class="mt-4 text-[#94a3b8]">
				Two products for SaaS businesses and freelancers, plus custom AI agents built to order.
			</p>
		</div>

		<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
			{products.map((product) => (
				<article
					class="flex flex-col rounded-2xl border border-[#334155]/50 bg-[#121826]/60 p-7 transition-colors duration-200 hover:border-[#38bdf8]/30"
				>
					<div
						class="flex h-12 w-12 items-center justify-center rounded-lg"
						style={{ backgroundColor: product.accentColor + '1a' }}
					>
						{product.icon === 'churn' && (
							<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path
									d="M12 7.5V3M12 3L9 6.75M12 3L15 6.75M15.75 12.75V19.5C15.75 20.3284 15.0784 21 14.25 21H5.25C4.4216 21 3.75 20.3284 3.75 19.5V8.25C3.75 7.4216 4.4216 6.75 5.25 6.75H14.25C15.0784 6.75 15.75 7.4216 15.75 8.25V12.75Z"
									stroke={product.accentColor}
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						)}
						{product.icon === 'cashflow' && (
							<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path
									d="M3 12a9 9 0 0 1 12.73-6.27M3 12v9a3 3 0 0 0 3 3h12M3 12l3 3m-3-3l3-3m3 3v-5.5m0 5.5l-3 3m3-3l3 3m-6 0h6m-6 0v5m6-5v5"
									stroke={product.accentColor}
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						)}
						{product.icon === 'sandbox' && (
							<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path
									d="M12 5.25L4.5 9v10.5c0 1.38.82 2.58 2.05 3.1l7.45 3.15c.27.11.55.16.83.16.28 0 .56-.05.83-.16l7.45-3.15c1.23-.52 2.05-1.72 2.05-3.1V9l-7.5-3.75z"
									stroke={product.accentColor}
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						)}
					</div>

					<h3 class="mt-5 font-heading text-2xl font-bold text-[#f1f5f9]">{product.title}</h3>
					<p class="mt-1 text-xs font-medium" style={{ color: product.accentColor }}>{product.tagline}</p>
					<p class="mt-3 text-sm leading-relaxed text-[#94a3b8]">{product.description}</p>

					<ul class="mt-6 flex-1 space-y-3">
						{product.features.map((feature) => (
							<li class="flex items-start gap-3 text-sm text-[#94a3b8]">
								<svg class="mt-0.5 h-4 w-4 shrink-0 text-[#10b981]" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
								<span>{feature}</span>
							</li>
						))}
					</ul>

					<div class="mt-8">
						{product.id === 'cashflow' ? (
							<a
								href="https://cashflow.metrictether.com"
								target="_blank"
								rel="noopener noreferrer"
								class="block w-full rounded-lg bg-gradient-to-r from-[#6366f1] to-[#38bdf8] py-2.5 text-center font-heading text-sm font-semibold text-[#0b0f17] transition-transform duration-200 hover:scale-[1.02]"
							>
								Go to App
							</a>
						) : product.id === 'sandbox' ? (
							<a
								href="#waitlist"
								class="block w-full rounded-lg border border-[#334155] py-2.5 text-center font-heading text-sm font-semibold text-[#f1f5f9] transition-colors duration-200 hover:bg-[#1e293b]"
							>
								Pitch Your Workflow
							</a>
						) : (
							<a
								href="#waitlist"
								class="block w-full rounded-lg bg-gradient-to-r from-[#6366f1] to-[#38bdf8] py-2.5 text-center font-heading text-sm font-semibold text-[#0b0f17] transition-transform duration-200 hover:scale-[1.02]"
							>
								Request Early Access
							</a>
						)}
					</div>
				</article>
			))}
		</div>
	</div>
</section>
