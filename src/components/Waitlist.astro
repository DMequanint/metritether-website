---
---

<section id="waitlist" class="relative py-20 sm:py-28">
	<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto mb-12 max-w-2xl text-center">
			<span class="inline-flex items-center gap-2 rounded-full border border-[#334155]/60 bg-[#121826]/60 px-3 py-1 text-xs font-medium text-[#38bdf8]">
				Early Access
			</span>
			<h2 class="mt-4 font-heading text-3xl font-bold text-[#f1f5f9] sm:text-4xl">
				Request Early Access
			</h2>
			<p class="mt-4 text-[#94a3b8]">
				Sign up for early access to Churn Analytics and FreelancerCashFlow.
			</p>
		</div>

		<div class="rounded-2xl border border-[#334155]/50 bg-[#121826]/60 p-6 sm:p-8">
			<form
				action="https://formspree.io/f/maypwjnv"
				method="POST"
				id="waitlist-form"
				class="space-y-6"
			>
				<input type="hidden" name="form-name" value="waitlist" />
				<input type="hidden" name="_next" value="https://metrictether.com#waitlist-success" />

				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
					<div>
						<label for="name" class="mb-1 block text-sm font-medium text-[#94a3b8]">Name</label>
						<input
							type="text"
							id="name"
							name="name"
							required
							placeholder="Jane Doe"
							class="w-full rounded-lg border border-[#334155]/50 bg-[#0b0f17]/50 px-4 py-2.5 text-[#f1f5f9] placeholder-[#64748b] transition-colors focus:border-[#38bdf8] focus:outline-none focus:ring-1 focus:ring-[#38bdf8]/30"
						/>
					</div>

					<div>
						<label for="email" class="mb-1 block text-sm font-medium text-[#94a3b8]">Email Address</label>
						<input
							type="email"
							id="email"
							name="_replyto"
							required
							placeholder="jane@company.com"
							class="w-full rounded-lg border border-[#334155]/50 bg-[#0b0f17]/50 px-4 py-2.5 text-[#f1f5f9] placeholder-[#64748b] transition-colors focus:border-[#38bdf8] focus:outline-none focus:ring-1 focus:ring-[#38bdf8]/30"
						/>
					</div>
				</div>

				<div>
					<label for="interest" class="mb-1 block text-sm font-medium text-[#94a3b8]">Primary Interest</label>
					<select
						id="interest"
						name="interest"
						required
						class="w-full rounded-lg border border-[#334155]/50 bg-[#0b0f17]/50 px-4 py-2.5 text-[#f1f5f9] transition-colors focus:border-[#38bdf8] focus:outline-none focus:ring-1 focus:ring-[#38bdf8]/30"
					>
						<option value="" disabled selected>Select a product</option>
						<option value="Churn Analytics">Churn Analytics — AI Email Interviewer</option>
						<option value="FreelancerCashFlow">FreelancerCashFlow — Financial OS</option>
						<option value="Custom AI Agents">Custom AI Agents Sandbox</option>
					</select>
				</div>

				<div>
					<label for="bottleneck" class="mb-1 block text-sm font-medium text-[#94a3b8]">
						What is your biggest operational or financial bottleneck?
					</label>
					<textarea
						id="bottleneck"
						name="bottleneck"
						rows="3"
						placeholder="e.g. Late payments from 30% of clients, or churn rate above 8% monthly..."
						class="w-full resize-y rounded-lg border border-[#334155]/50 bg-[#0b0f17]/50 px-4 py-2.5 text-[#f1f5f9] placeholder-[#64748b] transition-colors focus:border-[#38bdf8] focus:outline-none focus:ring-1 focus:ring-[#38bdf8]/30"
					></textarea>
				</div>

				<div class="flex items-start gap-3">
					<div class="mt-0.5 shrink-0">
						<input
							type="checkbox"
							id="consent"
							name="consent"
							value="yes"
							required
							class="h-4 w-4 rounded border-[#334155]/50 bg-[#0b0f17]/50 text-[#38bdf8] focus:ring-[#38bdf8]/30"
						/>
					</div>
					<label for="consent" class="text-sm text-[#94a3b8]">
						I agree to MetricTether contacting me. You can unsubscribe at any time.
					</label>
				</div>

				<button
					type="submit"
					class="w-full rounded-lg bg-gradient-to-r from-[#6366f1] to-[#38bdf8] py-3 font-heading text-base font-semibold text-[#0b0f17] transition-transform duration-200 hover:scale-[1.02]"
				>
					Request Access
				</button>
			</form>

			<div id="waitlist-success" class="hidden py-8 text-center">
				<svg class="mx-auto mb-4 h-12 w-12 text-[#10b981]" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				<h3 class="font-heading text-xl font-bold text-[#f1f5f9]">Thanks for joining!</h3>
				<p class="mt-2 text-[#94a3b8]">We'll be in touch soon with early access details.</p>
			</div>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById('waitlist-form');
	const success = document.getElementById('waitlist-success');

	if (window.location.hash === '#waitlist-success' && success) {
		form?.classList.add('hidden');
		success.classList.remove('hidden');
		window.history.replaceState(null, '', '#waitlist');
	}

	if (form && success) {
		form.addEventListener('submit', () => {
			form.classList.add('hidden');
			success.classList.remove('hidden');
			success.scrollIntoView({ behavior: 'smooth' });
		});
	}
</script>
