---
interface Props {
	title?: string;
	description?: string;
}
const {
	title = 'MetricTether — AI Agents for SaaS Churn Recovery & Freelancer Cash Flow',
	description = 'MetricTether builds AI agents that recover churned SaaS customers and stabilize freelancer cash flow. Explore Churn Analytics and FreelancerCashFlow.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href="https://metrictether.com/" />
		<meta name="theme-color" content="#0b0f17" />
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="MetricTether" />
		<meta property="og:url" content="https://metrictether.com/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://metrictether.com/og-image.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="MetricTether — AI Agents for SaaS Churn Recovery & Freelancer Cash Flow" />
		<meta property="og:locale" content="en_US" />

		<script type="application/ld+json" is:inline>
			{
				"@context": "https://schema.org",
				"@type": "Organization",
				"name": "MetricTether",
				"url": "https://metrictether.com/",
				"logo": "https://metrictether.com/logo.svg",
				"email": "info@metrictether.com",
				"telephone": "+4915755995080",
				"sameAs": ["https://github.com/metrictether"]
			}
		</script>

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://metrictether.com/og-image.png" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<meta name="color-scheme" content="dark" />

		<script is:inline defer data-domain="metrictether.com" src="https://plausible.io/js/script.js"></script>
	</head>
	<body class="min-h-screen flex flex-col bg-[#0b0f17] text-[#94a3b8] font-body antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-[#38bdf8] focus:px-4 focus:py-2 focus:font-heading focus:text-sm focus:font-semibold focus:text-[#0b0f17]"
		>
			Skip to content
		</a>
		<slot />
	</body>
</html>
