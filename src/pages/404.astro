---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="404 — Page Not Found | MetricTether" description="The page you're looking for doesn't exist.">
	<div class="min-h-screen flex items-center justify-center px-4 pt-16">
		<div class="text-center">
			<h1 class="text-6xl font-heading font-bold text-[#f1f5f9] mb-4">404</h1>
			<p class="text-[#94a3b8] mb-8 max-w-md mx-auto">
				The page you're looking for doesn't exist. It may have been moved or deleted.
			</p>
			<a
				href="/"
				class="inline-block bg-gradient-to-r from-[#6366f1] to-[#38bdf8] text-[#0b0f17] font-heading font-semibold py-2.5 px-6 rounded-lg transition-all duration-300 ease-out hover:scale-[1.02] hover:shadow-[0_0_25px_rgba(99,102,241,0.4)]"
			>
				← Back to Home
			</a>
		</div>
	</div>
</Layout>
