---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>404 — Page Not Found | MetricTether</title>
		<meta name="description" content="The page you're looking for doesn't exist." />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>

		<script is:inline defer data-domain="metrictether.com" src="https://plausible.io/js/script.js"></script>
	</head>
	<body class="bg-[#0b0f17] text-[#94a3b8] font-body antialiased">
		<div class="min-h-screen flex items-center justify-center px-4">
			<div class="text-center">
				<h1 class="text-6xl font-heading font-bold text-[#f1f5f9] mb-4">404</h1>
				<p class="text-[#94a3b8] mb-8 max-w-md mx-auto">
					The page you're looking for doesn't exist. It may have been moved or deleted.
				</p>
				<a
					href="/"
					class="inline-block bg-gradient-to-r from-[#6366f1] to-[#38bdf8] text-[#0b0f17] font-heading font-semibold py-2.5 px-6 rounded-lg transition-all duration-300 ease-out hover:scale-[1.02] hover:shadow-[0_0_25px_rgba(99,102,241,0.4)]"
				>
					← Back to Home
				</a>
			</div>
		</div>
	</body>
</html>
