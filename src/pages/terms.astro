---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Terms of Service | MetricTether" description="MetricTether terms of service.">
	<main id="main" class="min-h-screen px-4 py-20 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-3xl">
			<h1 class="font-heading text-3xl font-bold text-[#f1f5f9] mb-6">Terms of Service</h1>
			<p class="text-[#94a3b8] mb-4">
				By using metrictether.com you agree to these terms. The site is provided as-is for informational purposes about MetricTether products.
			</p>
			<p class="text-[#94a3b8] mb-4">
				Early-access requests do not constitute a contract or guarantee of service. Product features and timelines may change.
			</p>
			<p class="text-[#94a3b8]">
				Questions? Email <a href="mailto:info@metrictether.com" class="text-[#38bdf8]">info@metrictether.com</a>.
			</p>
			<div class="mt-10">
				<a href="/" class="text-[#38bdf8] hover:underline">← Back to home</a>
			</div>
		</div>
	</main>
</Layout>
